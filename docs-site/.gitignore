node_modules/
# Astro's build output is the top-level dist/ only — anchored, because an
# unanchored `dist/` also matches the generated API group
# src/content/docs/api/evoxc/dist/ and silently drops its pages.
/dist/
.astro/
.wrangler/
.nimbus/

.env
.env.local
.env.*.local
.env.production
.dev.vars
.dev.vars.*

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# NOTE: src/content/docs/api/ is deliberately NOT ignored — the generated Python
# API reference tree is committed (see CONTEXT.md).
